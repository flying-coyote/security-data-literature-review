# Session archives (local only - don't track in git)
.archive/

# Claude local settings (local only - don't track in git)
.claude/settings.local.json

# Claude agent worktrees (temporary, isolated subagent worktrees - never commit)
.claude/worktrees/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

# PDF/EPUB build output (reproducible via tools/build/build.sh; tooling + fonts ARE tracked)
/build/

# LaTeX aux from compiling figures (the figure PDFs ARE tracked)
*.aux
*.log

# Platform-specific
.env
.env.local
__pycache__/
